{
  "name": "kb-studio-pro",
  "private": true,
  "version": "0.1.0",
  "description": "KB Studio Pro — Sweet Pastel Edition. Your Lovely LIVE Control Center.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @kb/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "tauri": "pnpm --filter @kb/desktop tauri",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,css}\"",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "module"
}
