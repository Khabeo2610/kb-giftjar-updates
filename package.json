{
  "name": "kb-studio-pro",
  "private": true,
  "version": "0.1.0",
  "description": "KB Studio Pro — Sweet Pastel Edition. Your Lovely LIVE Control Center.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @kb/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "tauri": "pnpm --filter @kb/desktop tauri",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,css}\""
  }
}
