{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KB Studio Pro",
  "version": "0.1.0",
  "identifier": "vn.kbstudio.pro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KB Studio Pro — Sweet Pastel Edition",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KB Studio",
    "category": "Video",
    "shortDescription": "Your Lovely LIVE Control Center",
    "copyright": "© KB Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Vietnamese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
