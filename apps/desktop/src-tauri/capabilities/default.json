{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quyền tối thiểu cho cửa sổ chính. Chỉ cấp thêm quyền khi module thật sự cần.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
